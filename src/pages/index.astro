---
/* ამბავი · მთავარი გვერდი — ტელეფონები ცოცხალი მოსაწვევებით, რჩეული დიზაინები, ფუნქციები, პროცესი და შეკვეთის ბლოკი
   მენიუ, ფეხი და <head> — src/layouts/Site.astro */
import Site from "../layouts/Site.astro";
---
<Site page="home" title="ამბავი · ციფრული მოსაწვევები ქორწილისთვის და ყველა დღესასწაულისთვის" description="ციფრული მოსაწვევები ანიმაციებით, მუსიკით, 3D ეფექტებით და დასწრების დადასტურებით WhatsApp-ში. მზადდება 5 დღეში.">
<main>
  <!-- ===== ციფრული მოსაწვევი, რომელიც სტუმრებს დაამახსოვრდებათ ===== -->
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow"><svg class="i"><use href="#s-spark"/></svg>ქორწილი · ნიშნობა · დაბადების დღე · ნათლობა</span>
        <h1>ციფრული მოსაწვევი, რომელიც სტუმრებს <em>დაამახსოვრდებათ</em></h1>
        <p class="sub">სტუმარი ხსნის კონვერტს, საჩუქარს ან მარგალიტის ფარდას, ირთვება მუსიკა, ჩანს თქვენი ისტორია, განრიგი და რუკა. დასწრებას კი ერთი შეხებით ადასტურებს WhatsApp-ში.</p>
        <div class="ctas"><a class="btn dark" href="designs.html"><svg class="i"><use href="#s-eye"/></svg>დიზაინების ნახვა</a><a class="btn gold" href="order.html">შეკვეთა</a></div>
        <div class="stats"><div><b class="js-count">12</b><span>უნიკალური დიზაინი</span></div><div><b><span class="js-days">5</span> დღე</b><span>დამზადების ვადა</span></div><div><b>2</b><span>ენა: ქართული, ინგლისური</span></div></div>
      </div>
      <div class="phones" aria-hidden="true">
        <div class="phone back"><div class="screen"><iframe title="დაბადების დღის მოსაწვევი" data-src="invitations/birthday-salome-30/index.html?preview" tabindex="-1"></iframe><div class="shade"></div></div></div>
        <div class="phone front"><div class="screen"><iframe title="საქორწილო მოსაწვევი" data-src="invitations/wedding-kote-tako/index.html?open&amp;preview" data-autoscroll tabindex="-1"></iframe><div class="shade"></div></div></div>
      </div>
    </div>
  </section>

  <!-- ===== რჩეული დიზაინები ===== -->
  <section class="block alt">
    <div class="wrap">
      <div class="sec-head reveal"><span class="k">Our designs</span><h2>რჩეული დიზაინები</h2><p>ყველა დიზაინი ცოცხალია: დააჭირეთ „ნახვას“ და გახსენით ისე, როგორც თქვენი სტუმრები გახსნიან.</p></div>
      <div class="grid" data-designs="featured"></div>
      <div class="more reveal"><a class="btn dark" href="designs.html">ყველა დიზაინი <svg class="i"><use href="#s-arrow"/></svg></a></div>
    </div>
  </section>

  <!-- ===== რა შედის მოსაწვევში ===== -->
  <section class="block">
    <div class="wrap">
      <div class="sec-head reveal"><span class="k">Inside every invitation</span><h2>რა შედის მოსაწვევში</h2></div>
      <div class="feats" data-feats="4"></div>
      <div class="more reveal"><a class="btn line" href="features.html">ყველაფერი, რაც შედის <svg class="i"><use href="#s-arrow"/></svg></a></div>
    </div>
  </section>

  <!-- ===== მზადაა 5 დღეში ===== -->
  <section class="block alt">
    <div class="wrap">
      <div class="sec-head reveal"><span class="k">How it works</span><h2>მზადაა <span class="js-days">5</span> დღეში</h2><p>თქვენ გვიგზავნით დეტალებს, ჩვენ ვქმნით მოსაწვევს, ერთად ვასწორებთ და იღებთ მზა ბმულს.</p></div>
      <div class="steps">
        <div class="step reveal" style="--i:0"><h3>აირჩიეთ დიზაინი</h3><p>კოლექციიდან ან გვითხარით, რა ფერები და სტილი გინდათ.</p></div>
        <div class="step reveal" style="--i:1"><h3>გამოგვიგზავნეთ დეტალები</h3><p>სახელები, თარიღი, ადგილები, განრიგი და, თუ გინდათ, ფოტოები და ისტორია.</p></div>
        <div class="step reveal" style="--i:2"><h3>ნახეთ და დაადასტურეთ</h3><p>მე-4 დღეს გიგზავნით პირველ ვერსიას და ვასწორებთ, სანამ არ მოგეწონებათ.</p></div>
        <div class="step reveal" style="--i:3"><h3>გაუგზავნეთ სტუმრებს</h3><p>მე-5 დღეს იღებთ მზა ბმულს: WhatsApp-ში, Messenger-ში ან Instagram-ზე.</p></div>
      </div>
      <div class="more reveal"><a class="btn line" href="how.html">დღიდან დღემდე როგორ მზადდება <svg class="i"><use href="#s-arrow"/></svg></a></div>
    </div>
  </section>

  <!-- ===== მოვამზადოთ თქვენი მოსაწვევი? ===== -->
  <section class="block">
    <div class="wrap">
      <div class="contact reveal">
        <h2>მოვამზადოთ თქვენი მოსაწვევი?</h2>
        <p>შეავსეთ მოკლე ფორმა ან პირდაპირ მოგვწერეთ. მოსაწვევი მზად იქნება <span class="js-ready"></span>-ს.</p>
        <div class="ctas"><a class="btn gold" href="order.html">შეკვეთის ფორმა</a><a class="btn wa js-wa" href="#"><svg class="i"><use href="#s-wa"/></svg>WhatsApp</a></div>
      </div>
    </div>
  </section>
</main>
</Site>
