---
/* ამბავი · როგორ მუშაობს — 5-დღიანი პროცესი დღეების მიხედვით და რა გვჭირდება კლიენტისგან
   მენიუ, ფეხი და <head> — src/layouts/Site.astro */
import Site from "../layouts/Site.astro";
---
<Site page="how" title="როგორ მუშაობს · ამბავი" description="როგორ მზადდება ციფრული მოსაწვევი 5 დღეში: დეტალები, დიზაინი, პირველი ვერსია, შესწორებები და მზა ბმული.">
<main>
  <!-- ===== მოსაწვევი მზადდება 5 დღეში ===== -->
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="index.html">მთავარი</a><span>/</span><span>როგორ მუშაობს</span></p>
      <span class="k">How it works</span>
      <h1>მოსაწვევი მზადდება <span class="js-days">5</span> დღეში</h1>
      <p>თქვენ მხოლოდ დეტალებს გვიგზავნით. დანარჩენს ჩვენ ვაკეთებთ და ყოველ ნაბიჯზე გაცნობებთ, სად ვართ.</p>
      <p style="margin-top:22px"><span class="days-badge"><b class="js-days">5</b><span>სამუშაო დღე<small>შეკვეთიდან მზა ბმულამდე</small></span></span></p>
    </div>
  </section>

  <!-- ===== 5 დღე: დღიდან დღემდე ===== -->
  <section class="block alt">
    <div class="narrow">
      <ol class="days">
        <li class="day reveal"><span class="n"><small>დღე</small><b>1</b></span><div class="box"><h3>დეტალები და დიზაინი</h3><p>ვიღებთ თქვენს ინფორმაციას, ერთად ვირჩევთ დიზაინს, ფერებს და მუსიკას.</p></div></li>
        <li class="day reveal"><span class="n"><small>დღე</small><b>2</b></span><div class="box"><h3>ტექსტები და განრიგი</h3><p>ვწერთ და ვთარგმნით ტექსტებს, ვაწყობთ განრიგს, ადგილებს და რუკის ბმულებს.</p></div></li>
        <li class="day reveal"><span class="n"><small>დღე</small><b>3</b></span><div class="box"><h3>დიზაინი და ანიმაციები</h3><p>ვამატებთ ფოტოებს ან ილუსტრაციებს, გახსნის ანიმაციას, ეფექტებს და, სურვილისამებრ, 3D-ს.</p></div></li>
        <li class="day reveal"><span class="n"><small>დღე</small><b>4</b></span><div class="box"><h3>პირველი ვერსია</h3><p>გიგზავნით ბმულს. ამოწმებთ ტელეფონზე, გვეუბნებით, რა შევცვალოთ, და ვასწორებთ.</p></div></li>
        <li class="day reveal"><span class="n"><small>დღე</small><b>5</b></span><div class="box"><h3>მზა მოსაწვევი</h3><p>იღებთ საბოლოო ბმულს (და ვიდეოს, თუ შეუკვეთეთ). გაუგზავნეთ სტუმრებს და პასუხები პირდაპირ თქვენთან მოვა.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- ===== რა გვჭირდება თქვენგან ===== -->
  <section class="block">
    <div class="wrap split">
      <div class="reveal">
        <span class="k gold-text" style="font:400 34px/1 var(--script)">What we need</span>
        <h2>რა გვჭირდება თქვენგან</h2>
        <p>ყველაფერი შეგიძლიათ ერთ შეტყობინებაში გამოგვიგზავნოთ. რაც არ გაქვთ, ერთად მოვიფიქრებთ.</p>
        <ul class="ticks">
          <li>სახელები და ღონისძიების თარიღი</li>
          <li>დრო და ადგილები (ტაძარი, რესტორანი) მისამართებით</li>
          <li>WhatsApp ნომერი, სადაც სტუმრების პასუხები მოვა</li>
          <li>არჩეული დიზაინი ან სასურველი ფერები და სტილი</li>
          <li>ფოტოები და თქვენი ისტორია (სურვილისამებრ)</li>
          <li>დრესკოდი, პარკინგი ან სხვა მნიშვნელოვანი დეტალი</li>
        </ul>
        <div class="ctas" style="margin-top:26px"><a class="btn dark" href="order.html">შეკვეთის ფორმა</a><a class="btn line" href="faq.html">კითხვები</a></div>
      </div>
      <div class="media reveal"><div class="phone"><div class="screen"><iframe title="მოსაწვევის მაგალითი" data-src="invitations/wedding-lasha-tamar/index.html?open&amp;preview" data-autoscroll tabindex="-1"></iframe><div class="shade"></div></div></div></div>
    </div>
  </section>

  <!-- ===== ვადების შესახებ ===== -->
  <section class="block alt">
    <div class="wrap">
      <div class="sec-head reveal"><span class="k">Good to know</span><h2>ვადების შესახებ</h2></div>
      <div class="feats">
        <div class="feat reveal"><span class="ic"><svg><use href="#s-cal"/></svg></span><h3>შეუკვეთეთ დროულად</h3><p>მოსაწვევი სტუმრებს ღონისძიებამდე 3–6 კვირით ადრე ეგზავნება. ამიტომ ჯობს, შეკვეთა ამაზე ადრე დაიწყოთ.</p></div>
        <div class="feat reveal" style="--i:1"><span class="ic"><svg><use href="#s-clock"/></svg></span><h3><span class="js-days">5</span> დღე ითვლება</h3><p>იმ დღიდან, როცა ძირითადი დეტალები გვაქვს: სახელები, თარიღი, ადგილები და დიზაინი.</p></div>
        <div class="feat reveal" style="--i:2"><span class="ic"><svg><use href="#s-link"/></svg></span><h3>ბმული არ იცვლება</h3><p>თუ გაგზავნის შემდეგ რამე შეიცვალა, მოსაწვევს ვასწორებთ და სტუმრებთან იგივე ბმული რჩება.</p></div>
      </div>
    </div>
  </section>
  <!-- ===== მოვამზადოთ თქვენი მოსაწვევი? ===== -->
  <section class="block">
    <div class="wrap">
      <div class="contact reveal">
        <h2>მოვამზადოთ თქვენი მოსაწვევი?</h2>
        <p>შეავსეთ მოკლე ფორმა ან პირდაპირ მოგვწერეთ. თუ დღეს შეუკვეთავთ, მოსაწვევი მზად იქნება <span class="js-ready"></span>-ს.</p>
        <div class="ctas"><a class="btn gold" href="order.html">შეკვეთის ფორმა</a><a class="btn wa js-wa" href="#"><svg class="i"><use href="#s-wa"/></svg>WhatsApp</a></div>
      </div>
    </div>
  </section></main>
</Site>
